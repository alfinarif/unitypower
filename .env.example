# Copy to .env for local development. Use secret-manager environment variables
# in deployment instead of loading this file.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# SQLite is the default. Keep the existing db.sqlite3 for local development.
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_CONN_MAX_AGE=0

# Optional integrations
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v26.0
GOOGLE_APPLICATION_CREDENTIALS=firebase_api.json
# For cloud-managed identity instead of a service-account file:
# FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=true

# Deployment-only examples
# DJANGO_ALLOWED_HOSTS=unitypower.online,www.unitypower.online
# DJANGO_CSRF_TRUSTED_ORIGINS=https://unitypower.online,https://www.unitypower.online
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_TRUST_PROXY_SSL_HEADER=false
# DJANGO_SECURE_HSTS_SECONDS=31536000
